{
  "name": "android-site-blocker-private",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finalize-sw.mjs",
    "test": "npm run test:unit && npm run test:native-claims && npm run test:precache && playwright test",
    "test:precache": "npm run build && node --test scripts/verify-precache.test.mjs",
    "test:unit": "vitest run",
    "test:native-claims": "node --test scripts/native-claims.test.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cap:sync": "npm run build && node scripts/prepare-capacitor.mjs && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "1.58.2",
    "sharp": "^0.35.4",
    "sharp-cli": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
